{
  "name": "roadie",
  "version": "0.1.0",
  "private": true,
  "license": "Unlicense",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "dev:all": "tsx scripts/dev-all.ts",
    "dev:vertex": "ROADIE_MODEL=vertex ROADIE_VERTEX_PROJECT=roadie-prod-iab tsx scripts/dev-all.ts",
    "fakes": "tsx fakes/run-all.ts",
    "emulators": "firebase emulators:start --project demo-band-tracker --import .emulator-data --export-on-exit",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/seed.ts",
    "test": "npm run test:unit && npm run test:emulator",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:emulator": "firebase emulators:exec --config ${FIREBASE_TEST_CONFIG:-firebase.test.json} --only firestore,auth --project demo-band-tracker \"tsx --test --test-concurrency=${TEST_CONCURRENCY:-8} --import ./tests/emulator/setup.mjs tests/emulator/*.test.ts\"",
    "e2e": "tsx scripts/e2e.ts",
    "stats:pull": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/stats-pull.ts",
    "check:roadie": "GEMINI_API_KEY=$(cat .secrets/gemini-key.txt) ROADIE_MODEL=gemini ROADIE_GEMINI_MODEL=gemini-3.5-flash tsx scripts/roadie-check.ts",
    "check:roadie:vertex": "GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS:-.secrets/roadie-prod-iab-firebase-adminsdk-fbsvc-ec7be59afd.json} ROADIE_MODEL=vertex ROADIE_VERTEX_PROJECT=roadie-prod-iab tsx scripts/roadie-check.ts",
    "check:acts:vertex": "GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS:-.secrets/roadie-prod-iab-firebase-adminsdk-fbsvc-ec7be59afd.json} ROADIE_MODEL=vertex ROADIE_VERTEX_PROJECT=roadie-prod-iab tsx scripts/act-lookup-check.ts",
    "eval:roadie": "firebase emulators:exec --config firebase.test.json --only firestore,auth --project demo-band-tracker \"FIRESTORE_EMULATOR_HOST=127.0.0.1:8290 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9329 GCLOUD_PROJECT=demo-band-tracker GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS:-.secrets/roadie-prod-iab-firebase-adminsdk-fbsvc-ec7be59afd.json} ROADIE_MODEL=${ROADIE_MODEL:-vertex} ROADIE_VERTEX_PROJECT=roadie-prod-iab tsx scripts/roadie-eval.ts $ROADIE_EVAL\"",
    "genkit:ui": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker ROADIE_MODEL=${ROADIE_MODEL:-fake} genkit start -- tsx src/server/assistant/dev.ts",
    "typecheck": "tsc --noEmit",
    "leak-check": "tsx scripts/leak-check.ts",
    "lint": "tsc --noEmit",
    "worktree:ports": "tsx scripts/worktree-ports.ts",
    "shortcut:build": "tsx scripts/build-shortcut.ts",
    "mcp:stdio": "tsx mcp/server.ts --stdio",
    "backup": "tsx scripts/backup.ts",
    "rollouts": "tsx scripts/rollouts.ts",
    "wipe": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/wipe.ts",
    "restore": "tsx scripts/restore.ts",
    "align-auth": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/align-auth.ts",
    "migrate:posts-49": "tsx scripts/migrate-posts-49.ts",
    "test:all": "tsx scripts/test-all.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.43.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "genkit": "^1.43.0",
    "next": "^16.4.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.34.1",
    "genkit-cli": "^1.44.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
