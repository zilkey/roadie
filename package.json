{
  "name": "band-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "dev:all": "tsx scripts/dev-all.ts",
    "fakes": "tsx fakes/run-all.ts",
    "emulators": "firebase emulators:start --project demo-band-tracker --import .emulator-data --export-on-exit",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/seed.ts",
    "seed:real": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/seed-real.ts",
    "test": "firebase emulators:exec --config ${FIREBASE_TEST_CONFIG:-firebase.test.json} --only firestore,auth --project demo-band-tracker \"tsx --test --test-concurrency=1 tests/unit/*.test.ts\"",
    "e2e": "rm -rf .fake-data-test && firebase emulators:exec --config ${FIREBASE_TEST_CONFIG:-firebase.test.json} --only firestore,auth --project demo-band-tracker \"GCLOUD_PROJECT=demo-band-tracker tsx scripts/seed.ts && playwright test\"",
    "snapshot:setlists": "tsx scripts/snapshot-setlists.ts",
    "snapshot:october-tour": "tsx scripts/snapshot-october-tour.ts",
    "snapshot:venue-book": "tsx scripts/snapshot-venue-book.ts",
    "import:booking": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-booking-kit.ts",
    "import:show-income": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-show-income.ts",
    "import:gas": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-gas.ts",
    "import:song-list": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-song-list.ts",
    "import:rehearsal-history": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-rehearsal-history.ts",
    "import:setlist-songs": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-setlist-songs.ts",
    "import:setlists": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-setlists.ts",
    "import:venue-book": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-venue-book-sheet.ts",
    "seed-real:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/seed-real.ts",
    "import:booking:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/import-booking-kit.ts",
    "import:show-income:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/import-show-income.ts",
    "import:gas:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/import-gas.ts",
    "import:song-list:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/import-song-list.ts",
    "import:rehearsal-history:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/import-rehearsal-history.ts",
    "import:setlist-songs:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/import-setlist-songs.ts",
    "import:setlists:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/import-setlists.ts",
    "import:venue-book:prod": "GCLOUD_PROJECT=roadie-prod-iab tsx scripts/import-venue-book-sheet.ts",
    "stats:pull": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/stats-pull.ts",
    "genkit:ui": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker ROADIE_MODEL=${ROADIE_MODEL:-fake} genkit start -- tsx src/server/assistant/dev.ts",
    "typecheck": "tsc --noEmit",
    "leak-check": "tsx scripts/leak-check.ts",
    "lint": "tsc --noEmit",
    "worktree:ports": "tsx scripts/worktree-ports.ts",
    "mcp:stdio": "tsx mcp/server.ts --stdio",
    "backup": "tsx scripts/backup.ts",
    "wipe": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/wipe.ts",
    "restore": "tsx scripts/restore.ts",
    "migrate:history": "tsx scripts/migrate-history.ts",
    "migrate:artists": "tsx scripts/migrate-artists.ts",
    "migrate:strip-gear": "tsx scripts/migrate-strip-gear.ts",
    "migrate:pitched-as": "tsx scripts/migrate-pitched-as.ts",
    "migrate:venue-notes": "tsx scripts/migrate-venue-notes.ts",
    "migrate:pitch-dates": "tsx scripts/migrate-pitch-dates.ts",
    "migrate:mcp-per-band": "tsx scripts/migrate-mcp-per-band.ts",
    "migrate:show-page": "tsx scripts/migrate-show-page.ts",
    "migrate:checklists": "tsx scripts/migrate-checklists.ts",
    "migrate:rehearsal-location": "tsx scripts/migrate-rehearsal-location.ts",
    "migrate:crowd": "tsx scripts/migrate-crowd.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.43.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "genkit": "^1.43.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.34.1",
    "genkit-cli": "^1.44.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
