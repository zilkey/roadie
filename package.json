{
  "name": "band-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "dev:all": "tsx scripts/dev-all.ts",
    "fakes": "tsx fakes/run-all.ts",
    "emulators": "firebase emulators:start --project demo-band-tracker --import .emulator-data --export-on-exit",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/seed.ts",
    "test": "firebase emulators:exec --config firebase.test.json --only firestore,auth --project demo-band-tracker \"tsx --test --test-concurrency=1 tests/unit/*.test.ts\"",
    "e2e": "rm -rf .fake-data-test && firebase emulators:exec --config firebase.test.json --only firestore,auth --project demo-band-tracker \"GCLOUD_PROJECT=demo-band-tracker tsx scripts/seed.ts && playwright test\"",
    "import:booking": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/import-booking-kit.ts",
    "stats:pull": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker tsx scripts/stats-pull.ts",
    "genkit:ui": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8280 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9319 GCLOUD_PROJECT=demo-band-tracker ROADIE_MODEL=${ROADIE_MODEL:-fake} genkit start -- tsx src/server/assistant/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "mcp:stdio": "tsx mcp/server.ts --stdio",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "migrate:history": "tsx scripts/migrate-history.ts",
    "migrate:artists": "tsx scripts/migrate-artists.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.43.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "genkit": "^1.43.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.34.1",
    "genkit-cli": "^1.44.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
