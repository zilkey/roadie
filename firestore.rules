rules_version = '2';
// Per-artist reads (tenancy plan D6). ALL client writes are denied: writes go through the server (firebase-admin, which bypasses
// rules) in src/server/db.ts.
//
// The server (src/server/session.ts claimsFor) keeps three custom claims in step with users/{uid}.artists:
//   artists:   {artistId: 'admin' | 'member'}   your role in each artist ('ai' logins are never in it, so they read nothing here)
//   adminOf:   [artistId]                       the artists you are an admin of
//   musicians: {artistId: musicianId}           your musician record in each artist
// Every artist record carries `artistId`, and the rule checks your role in THAT artist, never your best role anywhere. List queries
// must therefore filter `artistId == <artist>` (the browser hooks add it, src/lib/client-scope.ts); an unfiltered list is refused.
// A collection-group wildcard ({path=**}) is used only for tracks and history (tests/unit/rules-shape.test.ts): rules OR together, so
// a wildcard `comments` match would widen pitch comments.
// Tenancy phase 10 moves artist records under their artist (`artists/{a}/shows/{id}`, platform/config.nestedPaths). Both layouts have
// rules here, so the browser works before, during and after the move; the top-level artist matches go once the old copies are deleted
// (scripts/delete-flat-copies.ts).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn()    { return request.auth != null; }
    function roles()       { return signedIn() ? request.auth.token.get('artists', {}) : {}; }
    function roleIn(a)     { return roles().get(a, ''); }
    function admin(a)      { return roleIn(a) == 'admin'; }
    function member(a)     { return roleIn(a) == 'member'; }
    function live()        { return resource.data.get('deletedAt', null) == null; }
    // The whole artist reads; soft-deleted records only its admins.
    function inArtist(a)   { return admin(a) || (member(a) && live()); }
    function anyRole()     { return roles().size() > 0; }
    function anyAdmin()    { return signedIn() && request.auth.token.get('adminOf', []).size() > 0; }
    // The shared directory: any admin reads it all; any member reads the live records.
    function shared()      { return anyAdmin() || (anyRole() && live()); }
    function me()          { return request.auth.uid; }
    function myMusician(a) { return request.auth.token.get('musicians', {}).get(a, ''); }
    function A()           { return resource.data.artistId; }
    // A get of a doc that doesn't exist (a show with no deal yet, an id of "none") reads as "doesn't exist" instead of failing on
    // resource.data, for anyone with a role in an artist. It only reveals that an id is unused, and ids are random.
    function missing()     { return anyRole() && resource == null; }
    // The same, for a doc under artists/{a}/… (phase 10): anyone with a role in that artist.
    function missingIn(a)  { return roleIn(a) != '' && resource == null; }

    // ---------- People ----------
    // A person reads their own users doc (My settings); an admin reads the people of the artists they run (People, driving & gas).
    // Lists must filter where('artistIds', 'array-contains', <artist>).
    match /users/{id}             { allow read: if (signedIn() && me() == id) || resource.data.get('artistIds', []).hasAny(request.auth.token.get('adminOf', [])); }
    // Unsubmitted forms and unsaved edits (id = uid__path): only their owner reads.
    match /unsubmittedDrafts/{id} { allow read: if signedIn() && resource.data.uid == me(); }
    // Per-user prefs (hidden nav sections and their order), id = uid: only their owner reads.
    match /userPrefs/{uid}        { allow read: if signedIn() && me() == uid; }
    // Server only, no rule on purpose: users/{uid}/private, googleGrants, invites, shortcutTokens, mutations, routeCache, geocodes,
    // metaConnections, stagePlotTokens, assistantStops, ledger, platform, platformUsers, platformArtists, sharedEditRequests, usage.

    // ---------- Shared directories ----------
    match /venues/{id}            { allow read: if shared(); }
    match /venueTypes/{id}        { allow read: if shared(); }
    match /venueEvents/{id}       { allow read: if shared(); }
    match /venueEventSources/{id} { allow read: if shared(); }
    match /acts/{id}              { allow read: if shared(); }
    match /promoters/{id}         { allow read: if anyAdmin(); }
    match /festivals/{id}         { allow read: if anyAdmin(); }
    match /editions/{id}          { allow read: if anyAdmin(); }
    // Weekly EIA fuel prices: any signed-in user.
    match /fuelPrices/{id}        { allow read: if signedIn(); }

    // ---------- The artist itself (its id is the artistId) ----------
    match /artists/{a} {
      allow get: if admin(a) || (member(a) && live());

      // ---------- Phase 10: the artist's records under its own doc (artists/{a}/shows/{id}) ----------
      // Path-based: the role is checked in the artist the path names. Every record also keeps its `artistId` (always equal to {a},
      // scripts/migrate-nested.ts checks it), and the browser still filters on it, so the same queries run in either layout.
      // A get of a missing doc reads as "doesn't exist" for anyone with a role in {a} (missingIn).
      match /shows/{id} {
        allow get: if missingIn(a) || inArtist(a);
        allow list: if inArtist(a);
        match /comments/{cid} { allow read: if admin(a) || (member(a) && live() && resource.data.get('audience', '') == 'band'); }
      }
      match /tours/{id} {
        allow get: if missingIn(a) || inArtist(a);
        allow list: if inArtist(a);
        match /entries/{eid} { allow read: if admin(a) || (member(a) && live() && resource.data.get('visibility', '') == 'band'); }
      }
      match /projects/{id}          { allow get: if missingIn(a) || inArtist(a); allow list: if inArtist(a); }
      match /songs/{id}             { allow get: if missingIn(a) || inArtist(a); allow list: if inArtist(a); }
      match /files/{id}             { allow get: if missingIn(a) || inArtist(a); allow list: if inArtist(a); }
      match /setlists/{id}          { allow get: if missingIn(a) || inArtist(a); allow list: if inArtist(a); }
      match /setlistTemplates/{id}  { allow get: if missingIn(a) || inArtist(a); allow list: if inArtist(a); }
      match /rehearsals/{id}        { allow get: if missingIn(a) || inArtist(a); allow list: if inArtist(a); }
      match /stagePlots/{id}        { allow get: if missingIn(a) || inArtist(a); allow list: if inArtist(a); }
      match /musicians/{id}         { allow get: if missingIn(a) || inArtist(a); allow list: if inArtist(a); }
      match /expenses/{id} {
        allow get: if missingIn(a) || admin(a) || (member(a) && live() && resource.data.userId == me());
        allow list: if admin(a) || (member(a) && live() && resource.data.userId == me());
      }
      match /availability/{id} {
        allow get: if missingIn(a) || admin(a) || (member(a) && live() && myMusician(a) != '' && myMusician(a) in resource.data.get('askedMusicianIds', []));
        allow list: if admin(a) || (member(a) && live() && myMusician(a) != '' && myMusician(a) in resource.data.get('askedMusicianIds', []));
      }
      match /payouts/{id} {
        allow get: if missingIn(a) || admin(a) || (member(a) && live()
          && (resource.data.get('to', {}).get('userId', '') == me()
              || (myMusician(a) != '' && resource.data.get('to', {}).get('musicianId', '') == myMusician(a))));
        allow list: if admin(a) || (member(a) && live()
          && (resource.data.get('to', {}).get('userId', '') == me()
              || (myMusician(a) != '' && resource.data.get('to', {}).get('musicianId', '') == myMusician(a))));
      }
      match /releases/{id} {
        allow get: if missingIn(a) || admin(a);
        allow list: if admin(a);
        match /tracks/{t} { allow read: if admin(a); }
      }
      match /income/{id}            { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /showDeals/{id}         { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /emailTemplates/{id}    { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /statSnapshots/{id}     { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /contacts/{id}          { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /venueNotes/{id}        { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /venueEventNotes/{id}   { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /actNotes/{id}          { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /festivalNotes/{id}     { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /editionNotes/{id}      { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /promoterNotes/{id}     { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /contactNotes/{id}      { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /checklistTemplates/{id} { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /emailThreads/{id}      { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /posts/{id}             { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /todos/{id}             { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /fans/{id}              { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /campaigns/{id}         { allow get: if missingIn(a) || admin(a); allow list: if admin(a); }
      match /socialChecklists/{id}  { allow read: if admin(a); }
      match /pitches/{id} {
        allow get: if missingIn(a) || admin(a);
        allow list: if admin(a);
        match /comments/{cid}  { allow read: if admin(a); }
        match /activity/{aid}  { allow read: if admin(a); }
      }
      // Not here (they stay top level, still with artistId): mcpTokens, shortcutTokens, invites, assistantThreads.
    }
    match /socialChecklists/{id}  { allow read: if admin(id); }

    // ---------- Artist: the whole artist reads ----------
    match /shows/{id} {
      allow get: if missing() || inArtist(A());
      allow list: if inArtist(A());
      // The band's own comments (audience "band") are read by members; ones carried over from the pitch have no audience: admins only.
      match /comments/{cid} { allow read: if admin(A()) || (member(A()) && live() && resource.data.get('audience', '') == 'band'); }
    }
    match /tours/{id} {
      allow get: if missing() || inArtist(A());
      allow list: if inArtist(A());
      // Members read only the entries with visibility "band" (options, the pitches, are "admins"); their queries filter on it.
      match /entries/{eid} { allow read: if admin(A()) || (member(A()) && live() && resource.data.get('visibility', '') == 'band'); }
    }
    match /projects/{id}          { allow get: if missing() || inArtist(A()); allow list: if inArtist(A()); }
    match /songs/{id}             { allow get: if missing() || inArtist(A()); allow list: if inArtist(A()); }
    match /files/{id}             { allow get: if missing() || inArtist(A()); allow list: if inArtist(A()); }
    match /setlists/{id}          { allow get: if missing() || inArtist(A()); allow list: if inArtist(A()); }
    match /setlistTemplates/{id}  { allow get: if missing() || inArtist(A()); allow list: if inArtist(A()); }
    match /rehearsals/{id}        { allow get: if missing() || inArtist(A()); allow list: if inArtist(A()); }
    match /stagePlots/{id}        { allow get: if missing() || inArtist(A()); allow list: if inArtist(A()); }
    match /musicians/{id}         { allow get: if missing() || inArtist(A()); allow list: if inArtist(A()); }

    // ---------- Artist: members see only their own ----------
    // Expenses a member logged; member lists filter userId == <me>.
    match /expenses/{id} {
      allow get: if missing() || admin(A()) || (member(A()) && live() && resource.data.userId == me());
      allow list: if admin(A()) || (member(A()) && live() && resource.data.userId == me());
    }
    // Availability asks naming the member's musician in that artist (the musicians claim); lists filter askedMusicianIds array-contains it.
    match /availability/{id} {
      allow get: if missing() || admin(A()) || (member(A()) && live() && myMusician(A()) != '' && myMusician(A()) in resource.data.get('askedMusicianIds', []));
      allow list: if admin(A()) || (member(A()) && live() && myMusician(A()) != '' && myMusician(A()) in resource.data.get('askedMusicianIds', []));
    }
    // Payouts made to the member, as the signed-in user (to.userId) or as their musician in that artist (to.musicianId).
    match /payouts/{id} {
      allow get: if missing() || admin(A()) || (member(A()) && live()
        && (resource.data.get('to', {}).get('userId', '') == me()
            || (myMusician(A()) != '' && resource.data.get('to', {}).get('musicianId', '') == myMusician(A()))));
      allow list: if admin(A()) || (member(A()) && live()
        && (resource.data.get('to', {}).get('userId', '') == me()
            || (myMusician(A()) != '' && resource.data.get('to', {}).get('musicianId', '') == myMusician(A()))));
    }

    // ---------- Artist: admins only ----------
    match /income/{id}             { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /releases/{id}           { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    // Tracks are read under their release and across releases (the song page's "On releases" is a collection-group query).
    match /{path=**}/tracks/{t}    { allow read: if admin(A()); }
    match /showDeals/{id}          { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /emailTemplates/{id}     { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /statSnapshots/{id}      { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /mcpTokens/{id}          { allow read: if admin(A()) && resource.data.userId == me(); }
    match /contacts/{id}           { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /venueNotes/{id}         { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /venueEventNotes/{id}    { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /actNotes/{id}           { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /festivalNotes/{id}      { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /editionNotes/{id}       { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /promoterNotes/{id}      { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /contactNotes/{id}       { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /checklistTemplates/{id} { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /emailThreads/{id}       { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /posts/{id}              { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /todos/{id}              { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /fans/{id}               { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /campaigns/{id}          { allow get: if missing() || admin(A()); allow list: if admin(A()); }
    match /pitches/{id} {
      allow get: if missing() || admin(A());
      allow list: if admin(A());
      // A pitch's comments and activity carry the pitch's artistId themselves.
      match /comments/{cid}  { allow read: if admin(A()); }
      match /activity/{aid}  { allow read: if admin(A()); }
    }
    // Roadie chat: only its owner, as an admin of the thread's artist.
    match /assistantThreads/{tid} {
      allow read: if admin(A()) && resource.data.ownerUid == me();
      match /messages/{mid} { allow read: if admin(get(/databases/$(database)/documents/assistantThreads/$(tid)).data.artistId)
                                          && get(/databases/$(database)/documents/assistantThreads/$(tid)).data.ownerUid == me(); }
    }

    // ---------- History: exactly one scope per entry (plan D4) ----------
    // An artist's records (artistId), one person's (ownerUid), or the shared directory's (shared: true, read by any admin).
    // Collection-group queries name one scope: artistId == <artist>, ownerUid == <me>, or artistId == null && shared == true.
    match /{path=**}/history/{rev} {
      allow read: if (resource.data.get('artistId', null) != null && admin(resource.data.artistId))
                  || (signedIn() && resource.data.get('ownerUid', null) == me())
                  || (resource.data.get('shared', false) == true && anyAdmin());
    }
  }
}
