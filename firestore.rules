rules_version = '2';
// Reads follow the blueprint's access table. ALL client writes are denied: writes go through
// the server (firebase-admin, which bypasses rules) in src/server/db.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Roles are per artist. The server (src/server/session.ts) keeps the custom claim `artists` = {artistId: role} in step
    // with users/{uid}.artists, holding only the app roles 'admin' and 'member'. The third role, 'ai' (a login for AI tools
    // only, via MCP keys on the server), is never in the claim, so it reads nothing here.
    function roles() { return signedIn() ? request.auth.token.get('artists', {}) : {}; }
    function roleIn(artistId) { return roles().get(artistId, ''); }
    // Band records aren't partitioned by artist yet (one band per project today; shows and pitches already carry artistId).
    // Until they are, your best role in any of your artists applies to them. TODO: once every record has artistId, use
    // roleIn(resource.data.artistId) and query with where('artistId', '==', ...).
    function isAdmin() { return 'admin' in roles().values(); }
    function isMember() { return !isAdmin() && 'member' in roles().values(); }
    function live() { return resource.data.get('deletedAt', null) == null; }
    // Whole band reads (admins and members); soft-deleted docs only show to admins.
    function band() { return isAdmin() || (isMember() && live()); }

    match /users/{id}            { allow read: if isAdmin(); }
    // Unsubmitted forms and unsaved edits (id = uid__path): only their owner reads, never written from the client (server writes with firebase-admin).
    match /unsubmittedDrafts/{id} { allow read: if signedIn() && resource.data.uid == request.auth.uid; }
    // Per-user prefs (hidden nav sections), id = uid: only their owner reads, server writes.
    match /userPrefs/{uid}       { allow read: if signedIn() && request.auth.uid == uid; }
    match /musicians/{id}        { allow read: if band(); }
    // An artist doc is readable by its own members only (the app reads it by id: /artists/[slug] resolves through your session).
    match /artists/{id}          { allow get: if roleIn(id) == 'admin' || (roleIn(id) == 'member' && live()); }
    match /shows/{id}            { allow read: if band(); }
    match /songs/{id}            { allow read: if band(); }
    match /files/{id}            { allow read: if band(); }
    match /setlists/{id}         { allow read: if band(); }
    match /rehearsals/{id}       { allow read: if band(); }

    match /availability/{id} {
      allow read: if isAdmin()
        || (isMember() && live() && request.auth.token.get('musicianId', '') in resource.data.askedMusicianIds);
    }
    match /ledger/{id} {
      allow read: if isAdmin()
        || (isMember() && live() && resource.data.kind in ['payout', 'reimbursement', 'correction']
            && resource.data.get('payeeUserId', '') == request.auth.uid);
    }
    match /expenses/{id} {
      allow read: if isAdmin() || (isMember() && live() && resource.data.userId == request.auth.uid);
    }

    // Admin only
    match /contacts/{id}           { allow read: if isAdmin(); }
    match /venues/{id}             { allow read: if isAdmin(); }
    match /promoters/{id}          { allow read: if isAdmin(); }
    match /festivals/{id}          { allow read: if isAdmin(); }
    match /editions/{id}           { allow read: if isAdmin(); }
    match /emailTemplates/{id}     { allow read: if isAdmin(); }
    match /checklistTemplates/{id} { allow read: if isAdmin(); }
    match /showDeals/{id}          { allow read: if isAdmin(); }
    match /statSnapshots/{id}      { allow read: if isAdmin(); }
    match /mcpTokens/{id}          { allow read: if isAdmin(); }
    // Every record's change log lives at {docPath}/history/{rev}, at any depth. Admin read only; written by the server in the same transaction as the change.
    match /{path=**}/history/{rev} { allow read: if isAdmin(); }
    // Roadie chat: only the owner (and only admins) read; writes are server-only.
    match /assistantThreads/{tid} {
      allow read: if isAdmin() && resource.data.ownerUid == request.auth.uid;
      match /messages/{mid} {
        allow read: if isAdmin() && get(/databases/$(database)/documents/assistantThreads/$(tid)).data.ownerUid == request.auth.uid;
      }
    }
    match /pitches/{id} {
      allow read: if isAdmin();
      match /comments/{cid}  { allow read: if isAdmin(); }
      match /activity/{aid}  { allow read: if isAdmin(); }
    }
  }
}
