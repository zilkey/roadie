# Instagram & Facebook against the local fake (fakes/fake-meta): a made-up app, not a real one. Production sets the real
# META_APP_ID and the META_APP_SECRET / META_TOKEN_KEY secrets (apphosting.yaml), and no META_*_URL.
META_APP_ID=fake-meta-app
META_APP_SECRET=fake-meta-secret
META_TOKEN_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
META_GRAPH_URL=http://127.0.0.1:3208
META_DIALOG_URL=http://127.0.0.1:3208/dialog/oauth
